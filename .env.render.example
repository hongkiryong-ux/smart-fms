# Render 환경변수 예시 (Dashboard → Environment 에 설정)
APP_SECRET_KEY=your-random-secret-key-here
ADMIN_ID=admin
ADMIN_PW=change-this-password
PUBLIC_BASE_URL=https://your-app.onrender.com
RENDER=true
COOKIE_HTTPS_ONLY=true
# PostgreSQL (Render Postgres 연결 시 자동 주입)
# DATABASE_URL=postgresql://...

# OnlyOffice Docs Community (자체 호스팅 Document Server)
# ONLYOFFICE_URL=https://your-onlyoffice.example.com
# ONLYOFFICE_JWT_SECRET=same-as-document-server-jwt-secret
# ONLYOFFICE_JWT_ENABLED=true
# Document Server가 FMS 파일/콜백에 접근할 주소 (보통 PUBLIC_BASE_URL 과 동일)
# ONLYOFFICE_INTERNAL_FILE_URL=https://your-app.onrender.com

# --- 가로등 QR 정비 (구 streetlamp_qr 환경변수, smart-fms 에 합침) ---
# CRON_SECRET=long-random-secret
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=01012345678
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev

# 가로등 CSV/엑셀 전체 재동기화(기동 시 누락만 기본 등록, 강제시 1)
# STREETLAPM_SYNC_LAMPS=1
